{
  "name": "@kikiutils/nuxt-session",
  "version": "3.1.6",
  "description": "Easy-to-use nuxt server-side session.",
  "author": "kiki-kanri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kikiutils/nuxt-session.git"
  },
  "keywords": [
    "nuxt",
    "nuxt session",
    "session"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    }
  },
  "types": "./dist/types.d.ts",
  "files": [
    "./dist"
  ],
  "engines": {
    "node": ">=18.12.1"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "bumplog": "changelogen --bump",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run build && changelogen --hideAuthorEmail --push --release && npm publish"
  },
  "dependencies": {
    "@kikiutils/nitro-session": "^3.0.0",
    "@nuxt/kit": "^3.16.2"
  },
  "devDependencies": {
    "@kikiutils/changelogen": "^0.8.0",
    "@kikiutils/eslint-config": "^0.12.0",
    "@nuxt/module-builder": "^1.0.1",
    "nuxt": "^3.16.2",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  }
}
